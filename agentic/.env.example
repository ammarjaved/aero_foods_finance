# Copy this to .env and fill in your values

# Anthropic
ANTHROPIC_API_KEY=sk-ant-...

# OpenAI
OPENAI_API_KEY=sk-...

# PostgreSQL
DB_HOST=localhost
DB_PORT=5432
DB_NAME=your_database_name
DB_USER=your_db_user
DB_PASSWORD=your_db_password

# API Server
FRONTEND_URL=http://your-php-app.com

# PHP app: set this to point to the Python API
STOCKBOT_API_URL=http://localhost:8000
